{
  "name": "Quesada Inmobiliaria - Embudo Captacion Vendedores Fiscal & Notarial",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-vendedor-quesada",
        "options": {}
      },
      "name": "Webhook Entrada Quesada",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "webhookId": "lead-vendedor-quesada"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.lead_scoring.category }}",
              "operation": "equal",
              "value2": "A"
            }
          ]
        }
      },
      "name": "Es Lead Prioridad Alta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "TU_GOOGLE_SHEET_ID_AQUI",
        "range": "Leads!A:K",
        "options": {},
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "Fecha",
              "fieldValue": "={{ $json.body.timestamp }}"
            },
            {
              "fieldId": "Nombre",
              "fieldValue": "={{ $json.body.lead.name }}"
            },
            {
              "fieldId": "Telefono",
              "fieldValue": "={{ $json.body.lead.phone }}"
            },
            {
              "fieldId": "Email",
              "fieldValue": "={{ $json.body.lead.email }}"
            },
            {
              "fieldId": "Ciudad",
              "fieldValue": "={{ $json.body.property_financials.city }}"
            },
            {
              "fieldId": "Precio Venta",
              "fieldValue": "={{ $json.body.financial_breakdown.sale_price }} €"
            },
            {
              "fieldId": "Neto Limpio",
              "fieldValue": "={{ $json.body.financial_breakdown.net_proceeds }} €"
            },
            {
              "fieldId": "Exencion +65",
              "fieldValue": "={{ $json.body.financial_breakdown.is_senior_exempt ? 'SI (' + $json.body.financial_breakdown.senior_savings + '€ ahorro)' : 'NO' }}"
            },
            {
              "fieldId": "Hipoteca",
              "fieldValue": "={{ $json.body.financial_breakdown.total_mortgage_outflow }} €"
            },
            {
              "fieldId": "Prioridad",
              "fieldValue": "={{ $json.body.lead_scoring.label }}"
            }
          ]
        }
      },
      "name": "Guardar en Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        740,
        220
      ]
    },
    {
      "parameters": {
        "chatId": "TU_TELEGRAM_CHAT_ID_O_CANAL",
        "text": "=🏢 *QUESADA INMOBILIARIA - NUEVO PROPIETARIO 🔥*\n\n👤 *Propietario:* {{ $json.body.lead.name }}\n📱 *Teléfono:* [{{ $json.body.lead.phone }}](https://wa.me/{{ $json.body.lead.phone.replace(/[^0-9]/g, '') }})\n📧 *Email:* {{ $json.body.lead.email }}\n\n📍 *Ubicación:* {{ $json.body.property_financials.city }}\n💶 *Precio Venta:* {{ $json.body.financial_breakdown.sale_price.toLocaleString('es-ES') }} €\n💰 *LÍQUIDO NETO CALCULADO:* {{ $json.body.financial_breakdown.net_proceeds.toLocaleString('es-ES') }} €\n\n{{ $json.body.financial_breakdown.is_senior_exempt ? '🎉 *EXENCIÓN +65 AÑOS:* ¡Ahorro de ' + $json.body.financial_breakdown.senior_savings.toLocaleString('es-ES') + ' € en IRPF!' : '⚖️ *IRPF Estimado:* ' + $json.body.financial_breakdown.irpf_tax_amount.toLocaleString('es-ES') + ' €' }}\n🏦 *Carga Hipotecaria a Cancelar:* {{ $json.body.financial_breakdown.total_mortgage_outflow.toLocaleString('es-ES') }} €\n🏛️ *Plusvalía Municipal:* {{ $json.body.financial_breakdown.plusvalia_municipal.toLocaleString('es-ES') }} €\n\n🏷️ *Cualificación:* {{ $json.body.lead_scoring.label }}\n⏱ *Plazo de Venta:* {{ $json.body.mortgage_and_costs.sale_urgency }}\n\n👉 [Contactar por WhatsApp ahora](https://wa.me/{{ $json.body.lead.phone.replace(/[^0-9]/g, '') }}?text=Hola%20{{ encodeURIComponent($json.body.lead.name) }},%20soy%20Juan%20Pedro%20de%20Quesada%20Inmobiliaria.%20He%20revisado%20tu%20simulaci%C3%B3n%20para%20{{ encodeURIComponent($json.body.property_financials.city) }})",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Alerta Telegram Juan Pedro Quesada",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        980,
        220
      ]
    },
    {
      "parameters": {
        "chatId": "TU_TELEGRAM_CHAT_ID_O_CANAL",
        "text": "=ℹ️ *Quesada Inmobiliaria - Lead Secundario*\n\n👤 *Nombre:* {{ $json.body.lead.name }}\n📱 *Teléfono:* {{ $json.body.lead.phone }}\n📍 *Municipio:* {{ $json.body.property_financials.city }}\n💶 *Venta:* {{ $json.body.financial_breakdown.sale_price.toLocaleString('es-ES') }} €\n💰 *Neto:* {{ $json.body.financial_breakdown.net_proceeds.toLocaleString('es-ES') }} €\n🏷️ *Nivel:* {{ $json.body.lead_scoring.label }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "name": "Alerta Telegram Lead Informativo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        740,
        420
      ]
    }
  ],
  "connections": {
    "Webhook Entrada Quesada": {
      "main": [
        [
          {
            "node": "Es Lead Prioridad Alta?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Es Lead Prioridad Alta?": {
      "main": [
        [
          {
            "node": "Guardar en Google Sheets",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alerta Telegram Lead Informativo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Guardar en Google Sheets": {
      "main": [
        [
          {
            "node": "Alerta Telegram Juan Pedro Quesada",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
